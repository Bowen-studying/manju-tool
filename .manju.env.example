# Copy this file to .manju.env and fill in your OpenAI-compatible service.
# The local demo launcher reads .manju.env without modifying your home folder.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Image generation (required only when an approved image-agent run uses --image-api)
MANJU_IMAGE_API_KEY=
MANJU_IMAGE_API_BASE=
MANJU_IMAGE_MODEL=
# single: local composite reference board; multi: provider receives data-URL list
MANJU_IMAGE_REFERENCE_MODE=single
MANJU_IMAGE_MAX_REFERENCES=1
MANJU_IMAGE_MULTI_REFERENCE_FIELD=images
# Comma-separated sizes accepted by your provider. auto chooses the closest
# match to storyboard creative_bible.aspect_ratio.
MANJU_IMAGE_SUPPORTED_SIZES=1024x1024,1024x1536,1536x1024
# Independent images sharing locked references can be submitted concurrently (1-16).
MANJU_IMAGE_MAX_PARALLEL=4
# Provider request timeout and image-download timeout are independent.
MANJU_IMAGE_TIMEOUT_SECONDS=300
MANJU_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=120
# cover avoids padded delivery bands; contain_blur preserves the whole frame;
# strict rejects provider output that is not already at the requested ratio.
MANJU_IMAGE_ASPECT_MODE=cover

# Separate OpenAI-compatible vision review service (optional; human review is the fallback)
MANJU_VISION_API_KEY=
MANJU_VISION_API_BASE=
MANJU_VISION_MODEL=
